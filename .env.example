# Doorman .env - copy this file to .env and edit the values.
# Secrets: never commit the real .env (it is gitignored).

# ---- Home Assistant ----
# HA base URL + long-lived access token (used for notify + camera.snapshot)
DOORMAN_HASS_URL=http://<ha-host>:8123
DOORMAN_HASS_TOKEN=<paste HA long-lived token>

# ---- MQTT broker (carries frigate/events) ----
DOORMAN_MQTT_HOST=<ha-host>
DOORMAN_MQTT_PORT=1883
DOORMAN_MQTT_USER=<mqtt user>
DOORMAN_MQTT_PASSWORD=<mqtt password>

# ---- Frigate / go2rtc ----
DOORMAN_FRIGATE_URL=http://<frigate-host>:5001
DOORMAN_FRIGATE_TOPIC=frigate/events
DOORMAN_FRONT_CAMERA=front_doorbell

# ---- Doorbell camera mic RTSP (visitor audio in) ----
DOORMAN_CAM_MIC_RTSP=rtsp://<user>:<pass>@<camera-ip>:554/cam/realmonitor?channel=1&subtype=1

# ---- Gemini Live ----
DOORMAN_GEMINI_API_KEY=<paste Gemini API key>
# optional prebuilt voice name; leave empty for Gemini default
DOORMAN_VOICE=

# ---- Behaviour ----
# true  = wait for face recognition and greet recognized visitors by name
# false = greet immediately on detection (no recognition wait)
DOORMAN_PERSONALIZED_GREETING=false
# Trigger mode:
#   person   = activate when Frigate detects a person at the door (default)
#   doorbell = activate when the HA doorbell_pressed binary_sensor turns on
DOORMAN_TRIGGER_MODE=person
# HA entity watched in doorbell trigger mode
DOORMAN_DOORBELL_SENSOR=binary_sensor.doorbell_pressed
DOORMAN_IDLE_TIMEOUT_S=25
DOORMAN_INTERACTION_MAX_S=120
DOORMAN_INTERACTION_COOLDOWN_S=20

# ---- snapshots (model's local still tooling; notification images are captured
# by HA's own camera.snapshot, so this only stores local stills) ----
DOORMAN_SNAPSHOT_DIR=/snapshots
