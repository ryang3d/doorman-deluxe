# Doorman .env - copy this file to .env and edit the values.
# Secrets: never commit the real .env (it is gitignored).

# ---- Home Assistant ----
# HA base URL + long-lived access token (used for notify + camera.snapshot)
DOORMAN_HASS_URL=http://<ha-host>:8123
DOORMAN_HASS_TOKEN=<paste HA long-lived token>

# ---- MQTT broker (carries frigate/events) ----
DOORMAN_MQTT_HOST=<ha-host>
DOORMAN_MQTT_PORT=1883
DOORMAN_MQTT_USER=<mqtt user>
DOORMAN_MQTT_PASSWORD=<mqtt password>

# ---- Frigate / go2rtc ----
DOORMAN_FRIGATE_URL=http://<frigate-host>:5001
DOORMAN_FRIGATE_TOPIC=frigate/events
DOORMAN_FRONT_CAMERA=front_doorbell

# ---- Doorbell camera mic RTSP (visitor audio in) ----
DOORMAN_CAM_MIC_RTSP=rtsp://<user>:<pass>@<camera-ip>:554/cam/realmonitor?channel=1&subtype=1
# The RTSP source the local engine's mic actually pulls from (go2rtc relay).
# DOORMAN_MIC_RTSP is preferred; DOORMAN_CAM_MIC_RTSP above is the legacy fallback.
# DOORMAN_MIC_RTSP=rtsp://<user>:<pass>@<go2rtc-host>:8554/<stream>

# ---- Mic source (which stream carries the visitor's voice) ----
# How Doorman gets the visitor's audio. Both the Gemini and local engines honor
# this. 'relay' (default) pulls the go2rtc RTSP stream above — proven to work but
# it adds an RTSP session on the camera, which can wedge the AD410 under
# concurrent-stream load. 'http' is the zero-RTSP fallback: it reads the camera's
# own native getAudio intercom over HTTP, so it adds NO RTSP session and keeps
# working when the relay wedges. 'webtrack' is the opt-in WebRTC received-audio
# track (experimental).
DOORMAN_MIC_SOURCE=relay
# Credentials for DOORMAN_MIC_SOURCE=http (the AD410's getAudio intercom). These
# are the camera's own HTTP digest credentials — typically the same user/pass as
# the RTSP stream above. The firmware rejects nonce reuse, so a fresh 401
# challenge is fetched on every stream open. Only used when MIC_SOURCE=http.
# DOORMAN_DOORBELL_HOST=<camera-ip>
# DOORMAN_DOORBELL_USER=admin
# DOORMAN_DOORBELL_PASSWORD=<doorbell-pass>

# ---- Gemini Live ----
DOORMAN_GEMINI_API_KEY=<paste Gemini API key>
# optional prebuilt voice name; leave empty for Gemini default
DOORMAN_VOICE=

# ---- Behaviour ----
# true  = wait for face recognition and greet recognized visitors by name
# false = greet immediately on detection (no recognition wait)
DOORMAN_PERSONALIZED_GREETING=false
# Trigger mode:
#   person   = activate when Frigate detects a person at the door (default)
#   doorbell = activate when the HA doorbell_pressed binary_sensor turns on
#   hybrid   = activate on either (person detection OR doorbell press)
DOORMAN_TRIGGER_MODE=person
# HA entity watched in doorbell trigger mode
DOORMAN_DOORBELL_SENSOR=binary_sensor.doorbell_pressed
# What to do when Frigate detects a cat or dog at the front door:
#   voice  (default) = push a notification (attaches a fresh frame) AND a short animal-aware greeting through the speaker
#   notify             = notification only, no speaker greeting
#   off                = ignore animals (person/doorbell triggers only)
DOORMAN_ANIMAL_BEHAVIOR=voice
# Master on/off for animal reactions, INDEPENDENT of DOORMAN_TRIGGER_MODE:
#   true  (default) = the Frigate listener runs in ANY trigger mode and cat/dog
#          events trigger the reaction per DOORMAN_ANIMAL_BEHAVIOR.
#   false = animal events are ignored regardless of trigger mode (and the Frigate
#          listener only runs if person-triggering needs it).
# This is separate from ANIMAL_BEHAVIOR=off: REACTIONS=false stops the listener
# from acting on animal events entirely; BEHAVIOR=off still listens but ignores.
DOORMAN_ANIMAL_REACTIONS=true
# hard cap (seconds) on an animal voice session; the greeting is short and the session ends on idle
DOORMAN_ANIMAL_MAX_S=45
DOORMAN_IDLE_TIMEOUT_S=25
DOORMAN_INTERACTION_MAX_S=120
DOORMAN_INTERACTION_COOLDOWN_S=20
# Door-zone gate (supplemental): an HA occupancy sensor that must have been 'on'
# continuously for DOORMAN_PERSON_HOLD_S seconds before a Frigate person/face
# trigger may fire. Empty = gate disabled (trigger on first detection, as before).
# The default is the front-patio person-occupancy zone on the front doorbell cam.
DOORMAN_PERSON_GATE=binary_sensor.front_patio_motion_zone_person_occupancy
# seconds the door-zone gate sensor must be held 'on' before a person/face trigger
DOORMAN_PERSON_HOLD_S=5
# Comma-separated Frigate face names to fully ignore (no voice greeting, no session).
# Case-insensitive; matched against the recognized face name. Only affects the
# personalized path (DOORMAN_PERSONALIZED_GREETING=true), where the name is known.
# Empty = ignore nobody (feature off).
DOORMAN_IGNORED_FACES=

# ---- snapshots (model's local still tooling; notification images are captured
# by HA's own camera.snapshot, so this only stores local stills) ----
DOORMAN_SNAPSHOT_DIR=/snapshots
# keep at most this many recent snapshots in the dir (0 = keep all / no pruning)
DOORMAN_SNAPSHOT_RETENTION=25

# ---- Local voice engine (DOORMAN_VOICE_ENGINE=local) ----
# When the engine is 'local', Doorman runs STT -> LLM -> TTS on the LAN instead of
# Gemini Live. The keys below route each stage; all are optional and default to the
# values in src/doorman_config.py.
# STT engine choice: point DOORMAN_STT_BASE_URL at whichever service is running.
#   Parakeet TDT 0.6B v3 : http://127.0.0.1:10301   (fast, RNN-T; can return '' on noise)
#   faster-whisper        : http://127.0.0.1:10302   (robust; returns no_speech_prob + language)
# faster-whisper is the recommended STT for the noisy far-field door mic.
DOORMAN_STT_BASE_URL=http://127.0.0.1:10302
# Anti-hallucination gate (faster-whisper only). Drop a transcription whose
# no_speech_prob exceeds this value before it reaches the brain. Real door speech
# measures ~0.00-0.05 on this mic; ambient-noise hallucinations ~0.30+. Default 0.25.
# No-op when STT is Parakeet (it returns no such field).
DOORMAN_LOCAL_STT_MAX_NSP=0.25
# Mic-stall recovery. The doorbell's RTSP relay wedges under concurrent stream
# load and delivers audio in bursts with 4-12 s gaps; on a gap this long the
# ffmpeg pull is killed and reopened so the next words aren't swallowed.
# Lower = more reopens (chatty on brief drops), higher = fewer (more words lost
# per stall). Default 5.0 s.
# DOORMAN_LOCAL_MIC_STALL_LIMIT_S=5.0
# Max ffmpeg reopens per interaction before giving up (dead-source bound). Default 8.
# DOORMAN_LOCAL_MIC_MAX_REOPENS=8
# LLM brain (OpenAI-compatible /chat/completions with tools)
# DOORMAN_LLM_BASE_URL=http://<llm-host>:30000/v1
# DOORMAN_LLM_MODEL=qwen3.8-27b
# DOORMAN_LLM_API_KEY=***
# TTS (Voicebox / Chatterbox). EN -> chatterbox_turbo (cloned voice); ES -> chatterbox.
# DOORMAN_TTS_BASE_URL=http://127.0.0.1:17600
# DOORMAN_TTS_PROFILE_EN=ffadb2a2-cacc-4c7f-8d26-69f7c4c22246
# DOORMAN_TTS_ENGINE_EN=chatterbox_turbo
# Local-engine keep-warm. The STT and TTS models are lazy: each cold-starts on the
# first real request, paying ~9s (STT) / ~22s (TTS) of model load + CUDA warm-up on
# the visitor's clock. keep_warm_loop is a process-lifetime background task (started
# in amain when DOORMAN_VOICE_ENGINE=local) that pings a 0.5s-silence /transcribe
# and a 1-word /generate on an interval so the models stay loaded and the inference
# path hot. No-op for the gemini engine.
# Delay before the FIRST warm-up ping (don't warm during process start-up). Default 30.
# DOORMAN_KEEP_WARM_SETTLE_S=30
# Repeat warm-up every N seconds. Default 1500 (25m).
# DOORMAN_KEEP_WARM_INTERVAL_S=1500
